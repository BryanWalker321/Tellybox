# Optional defaults for automated installs. Owners can configure station/Discord in Settings instead.
# Values saved in Settings override these defaults; private owner.json stays in DATA_DIR.
# Copy to .env; npm start reads it automatically. Keep secrets out of Git.
HOST=127.0.0.1
PORT=4173
# Must match the exact origin used by viewers (and the Discord redirect URI).
PUBLIC_BASE_URL=http://127.0.0.1:4173
# Discord Developer Portal > application > OAuth2.
# Register redirect: http://127.0.0.1:4173/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Your Discord server > destination channel > Integrations > Webhooks.
# All website channels log to this webhook, with their station channel name.
DISCORD_WEBHOOK_URL=
# Discord user IDs allowed to remove any comment (comma-separated).
DISCORD_MODERATOR_IDS=
CHAT_DAILY_LIMIT=20
# Optional custom persistent database folder:
# DATA_DIR=/path/to/persistent/data
# Set to 0 to disable the shared website/IPTV broadcast feed.
# IPTV_ENABLED=0
# FFMPEG_PATH=/path/to/ffmpeg
# FFPROBE_PATH=/path/to/ffprobe
# Optional Python environment with yt-dlp[default] for public YouTube/Dailymotion broadcast sources.
# PROVIDER_PYTHON=/path/to/venv/bin/python

# Optional public community invite and automatic server joining (same app bot).
DISCORD_INVITE_URL=
DISCORD_GUILD_ID=
DISCORD_BOT_TOKEN=
DISCORD_AUTO_JOIN=0

# Optional role assigned after automatic joining, including existing members.
DISCORD_JOIN_ROLE_ID=

# Optional Google Cast Custom Receiver, registered for this station URL.
# Owners can also configure these in Station control room > Station.
CAST_ENABLED=0
CAST_APP_ID=

# AirPlay controls and Anyview / system-mirroring help (independent of Google Cast).
AIRPLAY_ENABLED=1
MIRRORING_HELP_ENABLED=1
