{
  "name": "tellybox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A configurable, synchronised archive television service",
  "license": "MIT",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "dev": "node --env-file-if-exists=.env --watch server.mjs",
    "test": "node --test",
    "validate": "node scripts/validate.mjs",
    "import:archive": "node scripts/import-archive.mjs"
  }
}
